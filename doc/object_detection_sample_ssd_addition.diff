+#include "ie_api.h"
+
+//
+// Common options
+//
+
+#define VPU_CONFIG_KEY(name) InferenceEngine::VPUConfigParams::_CONFIG_KEY(VPU_##name)
+#define VPU_CONFIG_VALUE(name) InferenceEngine::VPUConfigParams::VPU_##name
+
